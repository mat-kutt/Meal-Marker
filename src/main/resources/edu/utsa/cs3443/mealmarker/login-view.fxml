<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.utsa.cs3443.mealmarker.controller.LoginController"
            prefWidth="900" prefHeight="600">

    <children>
        <VBox alignment="CENTER"
              spacing="18"
              prefWidth="380"
              AnchorPane.leftAnchor="260"
              AnchorPane.topAnchor="100">

            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <Label text="MEAL MAKER"
                   style="-fx-font-size: 30px; -fx-font-weight: bold;"/>

            <Label text="Your meals. Your budget. Your plan."
                   style="-fx-font-size: 14px;"/>

            <TextField fx:id="usernameTextField"
                       promptText="Username"
                       prefHeight="40"/>

            <PasswordField fx:id="passwordTextField"
                           promptText="Password"
                           prefHeight="40"/>

            <Button text="Login"
                    onAction="#login"
                    maxWidth="Infinity"
                    prefHeight="40"/>

            <HBox alignment="CENTER" spacing="10">
                <Button text="Create Account"
                        onAction="#createAccount"/>

                <Button text="Forgot Password?"
                        onAction="#forgotPassword"/>
            </HBox>

        </VBox>
    </children>
</AnchorPane>